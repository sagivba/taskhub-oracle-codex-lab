# Task 70 local-only settings. Copy this file to .env and create the listed
# secret files with mode 0600. Never place a real password in this file.
TASKHUB_DB_HOST_PORT=1522
TASKHUB_ORDS_HOST_PORT=8181
TASKHUB_APEX_HOME=./.task70/apex/apex

TASKHUB_SYS_PASSWORD_FILE=./.secrets/sys-password.txt
TASKHUB_ORDS_PUBLIC_PASSWORD_FILE=./.secrets/ords-public-password.txt
TASKHUB_APEX_PUBLIC_PASSWORD_FILE=./.secrets/apex-public-password.txt
TASKHUB_APEX_LISTENER_PASSWORD_FILE=./.secrets/apex-listener-password.txt
TASKHUB_APEX_REST_PUBLIC_PASSWORD_FILE=./.secrets/apex-rest-public-password.txt
TASKHUB_APEX_ADMIN_PASSWORD_FILE=./.secrets/apex-admin-password.txt
TASKHUB_APEX_ALICE_PASSWORD_FILE=./.secrets/apex-alice-password.txt
TASKHUB_APEX_BOB_PASSWORD_FILE=./.secrets/apex-bob-password.txt
